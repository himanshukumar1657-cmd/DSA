
class Solution {
    public boolean isPalindromic(String s) {
        String binary="";
    for(int i=0;i<s.length();i++){
        int j=(int)(s.charAt(i));
       String binary1 = String.format("%8s", Integer.toBinaryString(j)).replace(' ', '0');
        binary+=binary1;
        
       }
        int low=0;
        int high=binary.length()-1;
        while(low<high){
            if(binary.charAt(low)!=binary.charAt(high)){
                return false;
            }
            low++;
            high--;
        }
        return true;
    }
}
