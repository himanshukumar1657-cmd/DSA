///  generate permutation

public class genpermu {
    public static void gen_mu(String str,int idx){
        if(idx==str.length()){
            System.out.println(str);
        }
        for(int i=idx;i<str.length();i++){
           str=swap(str,i,idx);
           gen_mu( str,idx +1);
           str=swap(str,i,idx);
        }

    }
    public static String swap(String str,int i,int idx){
        char[] chars=str.toCharArray();
        char temp=chars[i];
        chars[i]=chars[idx];
        chars[idx]=temp;
        return new String(chars);
    }
    public static void main(String[] args) {
     
        gen_mu("abc",0);
    }
    
}

