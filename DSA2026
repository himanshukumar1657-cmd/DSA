// sequence combination
class Comptri{
    public static void comnination(String str,int i,String ans){
        if(i==str.length()){
           // ArrayList<String>s1=new ArrayList<>();
           System.out.println(ans);
           return;

        }
        char j=str.charAt(i);
        comnination( str,i+1, ans+j);
        comnination(str,i+1, ans);

    }
    public static void main(String[] args) {
        
        comnination("abc",0, "");


        
    }
}


